# Public WebUI/API port on the host
APP_PORT=18770

# WebUI + HTTP Basic Auth
WEBUI_USERNAME=admin
WEBUI_PASSWORD=change-this-password

# Flask session signing key. Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-random-64-hex

# Browserless auth token. Generate with: openssl rand -hex 24
BROWSERLESS_TOKEN=replace-with-random-token

# Base URL returned in MP4/TXT download links
PUBLIC_BASE_URL=http://SERVER_IP:18770

# Usually leave BROWSERLESS_URL unset so scripts/deploy.sh can auto-detect
# and safely reuse a compatible running Browserless when possible.
# BROWSERLESS_URL=http://host.docker.internal:3080

# Optional image override for a clean host with no Browserless image.
# Pin a version/digest in production instead of floating latest.
# BROWSERLESS_IMAGE=browserless/chrome@sha256:57d19e414d9fe4ae9d2ab12ba768c97f38d51246c5b31af55a009205c136012f

# Trust X-Forwarded-* only behind a reverse proxy you control
TRUST_PROXY_HEADERS=false
PROXY_HOPS=1

# Retry count for transient parse/download failures
MAX_PARSE_ATTEMPTS=3
